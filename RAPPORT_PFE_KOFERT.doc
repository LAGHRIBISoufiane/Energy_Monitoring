<h2>Annexe B — Modèle de Données EnergyData</h2>
<pre>
class EnergyData {
  final double powerFactor;    // 0.0–1.0
  final double voltage;        // Volts
  final double current;        // Ampères
  final double power;          // Watts
  final double energy;         // mWh (cumulatif)
  final double frequency;      // Hz
  final double windSpeed;      // % (Unit 2 seulement)
  final int    waterLevel;     // % (Unit 3 seulement)
  final DateTime timestamp;
  final String unitId;         // KOFERT_Unit_1 | _2 | _3
}
</pre>

<h2>Annexe C — Schéma Firestore : maintenance_logs</h2>
<pre>
// maintenance_logs/{logId}
{
  // Création
  unitId:         string,       // "KOFERT_Unit_1" | "_2" | "_3"
  type:           string,       // "inspection" | "repair" | "calibration"
  technicianName: string,
  description:    string,
  assignedToUid:  string | null,
  assignedToName: string | null,
  createdBy:      string,       // UID créateur
  timestamp:      Timestamp,

  // Résolution
  resolved:        boolean,
  resolvedAt:      Timestamp | null,
  resolvedBy:      string | null,
  resolvedByUid:   string | null,

  // Rapport de résolution (nouveaux champs — optionnels)
  resolutionProblem:   string | null,
  resolutionSolution:  string | null,
  attachmentBase64:    string | null,  // data:mime;base64,... — max ~375KB stocké
  attachmentName:      string | null,
}
</pre>

<h2>Annexe E — Commandes de Déploiement</h2>
<pre>
# Build Flutter Web
cd kofert_dashboard
flutter build web --release

# Déploiement complet
cd ..
npx firebase-tools deploy --only hosting
npx firebase-tools deploy --only functions
npx firebase-tools deploy --only firestore:rules

# Rotation d'un secret
npx firebase-tools functions:secrets:set EMAILJS_PRIVATE_KEY

# Vérifier les fonctions déployées
npx firebase-tools functions:list
</pre>

