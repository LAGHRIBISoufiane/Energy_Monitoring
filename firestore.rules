rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin()     { return isSignedIn() && role() == 'admin'; }
    function isModerator() { return isSignedIn() && (role() == 'admin' || role() == 'moderator'); }
    function isOperator()  { return isSignedIn() && role() in ['admin', 'moderator', 'operator']; }
    function isAnyUser()   { return isSignedIn() && role() in ['admin', 'moderator', 'operator', 'observer', 'viewer']; }

    // ── sensor_readings (time-series, one doc per unit per minute) ──────────
    // Write: any authenticated operator or above (dashboard writes via service)
    // Read:  any authenticated user
    match /sensor_readings/{readingId} {
      allow read: if isAnyUser();
      allow create: if isOperator()
        && request.resource.data.keys().hasAll(['unitId', 'timestamp', 'voltage', 'current'])
        && request.resource.data.unitId is string
        && request.resource.data.unitId in ['KOFERT_Unit_1', 'KOFERT_Unit_2', 'KOFERT_Unit_3'];
      allow update, delete: if isAdmin();
    }

    // ── unit_status (latest snapshot per unit, one doc per unit) ───────────
    // Write: operator+ (dashboard upserts via service)
    // Read:  any authenticated user
    match /unit_status/{unitId} {
      allow read: if isAnyUser();
      allow write: if isOperator()
        && unitId in ['KOFERT_Unit_1', 'KOFERT_Unit_2', 'KOFERT_Unit_3'];
    }

    // ── maintenance_logs ────────────────────────────────────────────────────
    match /maintenance_logs/{logId} {
      allow read: if isAnyUser();
      allow create: if isOperator()
        && request.resource.data.keys().hasAll(['unitId', 'type', 'technicianName', 'timestamp', 'createdBy']);
      // Operators can update; assigned user can mark resolved even if observer/viewer
      allow update: if isOperator()
        || (isAnyUser() && resource.data.get('assignedToUid', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── users (role store + profile) ───────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read profile data (needed for chat, user search, DM)
      allow read: if isSignedIn();

      // On first login a user creates their own document — any fields allowed
      // (bootstrap: admin account sets its own role during initial provisioning).
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Updates by the document owner: allowed only if 'role' is NOT being changed.
      // Moderator can update any user's role (but cannot promote to 'admin').
      // Admin can do anything.
      allow update: if
        (isSignedIn() && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || (isModerator() && request.resource.data.get('role', resource.data.get('role', 'viewer')) != 'admin')
        || isAdmin()
        // Bootstrap exception: hardcoded admin can set their own role to 'admin'
        // even when their Firestore role hasn't been persisted yet.
        || (isSignedIn() && request.auth.uid == userId
            && request.auth.token.email == 'soufianelaghri1@gmail.com'
            && request.resource.data.get('role', '') == 'admin');

      allow delete: if isAdmin();
    }

    // ── global_chat (shared chat room) ─────────────────────────────────────
    match /global_chat/{msgId} {
      allow read: if isAnyUser();
      allow create: if isAnyUser()
        && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'timestamp'])
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── dm_chats (direct messages, chatId = uid1_uid2 sorted) ────────────────
    match /dm_chats/{chatId} {
      function isParticipant() {
        return chatId.matches(request.auth.uid + '_.*')
            || chatId.matches('.*_' + request.auth.uid);
      }
      allow read, write: if isSignedIn() && isParticipant();
      match /messages/{msgId} {
        allow read: if isSignedIn() && isParticipant();
        allow create: if isSignedIn() && isParticipant()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── invitations (pending role invitations sent by admin/moderator) ────────
    match /invitations/{invId} {
      // Admin or moderator can create invitations
      allow create: if isModerator();
      // Admin/moderator can read all; invited user can read their own invitation
      allow read: if isModerator()
        || (isSignedIn() && resource.data.email == request.auth.token.email);
      // Invited user can update status (accept/decline); admin/moderator can manage
      allow update: if isModerator()
        || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // ── alerts (triggered by dashboard, shown in AlertHistoryScreen) ──────────
    match /alerts/{alertId} {
      allow read: if isAnyUser();
      allow create: if isAnyUser();
      allow delete: if isAdmin();
    }

    // ── contacts (per-user DM contact list) ──────────────────────────────────
    match /contacts/{userId}/list/{contactId} {
      // Owner can fully manage their own contacts list
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      // Anyone signed in can add themselves as a contact of another user (mutual)
      allow create, update: if isSignedIn() && request.auth.uid == contactId;
    }

    // ── config (app-wide settings written by admin, read by all users) ────────
    match /config/{docId} {
      allow read:  if isAnyUser();
      allow write: if isAdmin();
    }

    // ── user_logs (activity audit trail) ────────────────────────────────────
    match /user_logs/{logId} {
      // Only admin and moderator can read logs
      allow read: if isSignedIn() && (role() == 'admin' || role() == 'moderator');
      // Any authenticated user can create their own log entry
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['userId', 'userEmail', 'action', 'timestamp'])
        && request.resource.data.userId == request.auth.uid;
      // Only admin can modify or delete
      allow update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
